#!/usr/bin/env python

import uproot
import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import h5py
import os

with h5py.File(f'transient/Asymmetry_experimental.h5', 'r') as f:
	edges_e     = f['edges'][:]
	Wp_counts_e = f['Wp_counts'][:]
	Wm_counts_e = f['Wm_counts'][:]
	A_e         = f['A'][:]
	sigma_A_e   = f['sigma_A'][:]

width_e=edges_e[1]-edges_e[0]
centers_e = edges_e+(width/2)

plt.figure()
plt.bar(edges_e, Wp_counts_e, width=width_e, align='edge',color='red',label='Wp')
plt.bar(edges_e, Wm_counts_e, width=width_e, align='edge',color='blue',label='Wm')
plt.xlabel('Transverse Momenta [GeV]')
plt.ylabel('Counts')
plt.legend()
plt.savefig(f'transient/Combined_Transverse_Momenta_experimental.png')

plt.figure()
plt.errorbar(centers_e,A_e,yerr=sigma_A_e,fmt='o',capsize=4,ecolor='black',elinewidth=1,markersize=6)
plt.xlabel('Transverse Momenta [GeV]')
plt.ylabel('Asymmetry')
plt.savefig(f'transient/Asymmetry_experimental.png')

with h5py.File(f'transient/Asymmetry_prediction.h5', 'r') as f:
        edges_p     = f['edges'][:]
        Wp_counts_p = f['Wp_counts'][:]
        Wm_counts_p = f['Wm_counts'][:]
        A_p         = f['A'][:]
        sigma_A_p   = f['sigma_A'][:]

width_p=edges_p[1]-edges_p[0]
centers_p = edges_p+(width/2)

plt.figure()
plt.bar(edges_p, Wp_counts_p, width=width_p, align='edge',color='red',label='Wp')
plt.bar(edges_p, Wm_counts_p, width=width_p, align='edge',color='blue',label='Wm')
plt.xlabel('Transverse Momenta [GeV]')
plt.ylabel('Counts')
plt.legend()
plt.savefig(f'transient/Combined_Transverse_Momenta_prediction.png')

plt.figure()

plt.errorbar(centers_p,A_p,yerr=sigma_A_p,fmt='o',capsize=4,ecolor='black',elinewidth=1,markersize=6)
plt.xlabel('Transverse Momenta [GeV]')
plt.ylabel('Asymmetry')
plt.savefig(f'transient/Asymmetry_prediction.png')



print('Done')
